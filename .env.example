# ============================================================
# 大模型（必填其一）
# 预设：deepseek | openai | anthropic | qwen | moonshot | zhipu
#      | siliconflow | openrouter | gemini | ollama | vllm | custom
# 详细申请步骤见 docs/PROVIDERS.md
# ============================================================
LLM_PROVIDER=deepseek

# 只填所选供应商对应的那一个 Key 即可（其余留空）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 通义千问 / 阿里云百炼
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# 自定义端点或本地服务的通用 Key（ollama/vllm 可留空）
LLM_API_KEY=

# 覆盖预设默认值（留空则用预设）
LLM_MODEL=
LLM_BASE_URL=

LLM_TIMEOUT=35
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
# json（默认，兼容性最好）| native（OpenAI function calling / Anthropic tool_use）
LLM_TOOL_PROTOCOL=json
# DeepSeek 等支持 thinking 开关的供应商：短 JSON 任务关闭思考
LLM_THINKING_DISABLE=true
# 仅评测/回归时建议开启：缓存模型响应，省成本但会让线上结果「不新鲜」
LLM_CACHE_ENABLED=false
# 分析结果缓存：相同(租户/仓库/issue/补充/模型/Prompt指纹)直接复用，只缓存成功结果
RESULT_CACHE_ENABLED=true
RESULT_CACHE_TTL_S=900
# 成本核算单价（$/百万 token）；不填则成本指标恒为 0（不显示假数字）
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0

# ============================================================
# GitHub（只读接口；公开仓库，或 Token 有权限的私有仓库）
# 申请步骤见 docs/PROVIDERS.md 的「GitHub Token」一节
# 匿名 60 次/小时；配置 Token 后 5000 次/小时
# 可选：仅作为服务端默认 Token；用户可以直接在页面填写自己的 Token
# ============================================================
GITHUB_TOKEN=
GITHUB_TIMEOUT=12
GITHUB_MAX_PAGES=3
GITHUB_HTTP_TTL=1800

# ============================================================
# 预算（防止 Agent 死循环烧钱）
# ============================================================
MAX_ROUNDS=3
MAX_STEPS=12
MAX_LLM_CALLS=16
MAX_TOOL_CALLS=20
MAX_REWRITES=1
ENABLE_LLM_CRITIQUE=true
TOKEN_BUDGET=80000
COST_BUDGET_USD=0.10
WALL_CLOCK_BUDGET_S=120

# ============================================================
# 上下文 / 检索
# ============================================================
CONTEXT_CHAR_BUDGET=12000
MAX_EVIDENCE_DOCS=24
RETRIEVAL_TOP_K=8
RERANK_TOP_K=6
# 向量化：hashing（默认，离线可复现）| openai（任意 OpenAI 兼容 /embeddings 端点）
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIM=512
MEMORY_RECALL_K=3

# ============================================================
# 服务与安全
# ============================================================
# dev：未配置 API_KEYS 时仅允许本机访问；prod：强制要求 API_KEYS + CORS + 限流
ISSUE_AGENT_ENV=dev
# 格式 key:tenant,key2:tenant2；Key 至少 8 位
API_KEYS=
DEV_TENANT=local
RATE_LIMIT_PER_MIN=20
# 生产必须显式列出，逗号分隔
CORS_ORIGINS=
MAX_USER_CONTEXT_CHARS=600
LOG_LEVEL=INFO
REQUEST_TIMEOUT_S=120
JOB_WORKERS=2
JOB_TTL_S=3600

# ============================================================
# 存储
# ============================================================
ISSUE_AGENT_DATA_DIR=data
ISSUE_AGENT_DB=
ISSUE_AGENT_TRACE_DIR=
